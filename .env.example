# ==============================================================================
# OmegaMart Environment Configuration Template
# Copy this file to '.env' or supply as system environment variables.
# NEVER commit real credentials or production API keys to source control.
# ==============================================================================

# Application Environment (development, testing, production)
APP_ENV=development
APP_PORT=8080

# Database Configuration (Embedded persistent H2 database)
DB_DRIVER=org.h2.Driver
DB_URL=jdbc:h2:file:./data/omegamartdb;DB_CLOSE_DELAY=-1;AUTO_SERVER=TRUE
DB_USER=sa
DB_PASSWORD=

# HikariCP Connection Pool Settings
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_CONNECTION_TIMEOUT=20000

# Security Settings
SESSION_TIMEOUT_MINUTES=30
COOKIE_SECURE=false

# AI Chatbot Configuration
# Options: MOCK or GEMINI
CHATBOT_PROVIDER=MOCK
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
